{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/Dockerfile"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\nARG \\w+=(?<currentValue>.*)"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [".github/workflows/*.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>[^\\n]+)\\n\\s+(?:version|cosign-release): (?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "matchDatasources": ["docker"],
      "versionCompatibility": "^(?<version>[^-]+)(?<compatibility>-.*)?$",
      "versioning": "docker"
    },
    {
      "matchPackageNames": ["timescale/timescaledb", "oras-project/oras"],
      "matchDatasources": ["github-releases"],
      "extractVersion": "^v?(?<version>.*)$"
    },
    {
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "labels": ["dependencies", "safe-automerge"]
    },
    {
      "matchPackageNames": ["timescale/timescaledb"],
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "labels": ["dependencies", "database-migration", "needs-review"]
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "draftPR": true,
      "labels": ["dependencies", "major", "needs-review"]
    }
  ]
}
